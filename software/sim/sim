#!/usr/bin/env python3
"""sim — the gateway and node firmware, unchanged, in QEMU on virtual CAN
buses, with buttons, PIR, relays and sensors you can play.

  sim up                        start everything in sim.toml, show what happens
  sim tui                       the same in one screen, keys for everything
  sim status                    what runs, IPs, relays, sensor values
  sim press taster-flur 0       press a button (single, double, triple, hold)
  sim motion taster-flur        the PIR sees someone
  sim set taster-flur bme680 temperature=25 humidity=60
  sim get taster-flur           every part of a chip and its values
  sim i2c taster-flur           the I2C traffic; also scan, read, write, dump
  sim run scenario.py           a script with `sim` (simlib/client.py)
  sim console gw-eg             the chip's serial console (Ctrl-] leaves)
  sim web gw-eg                 open the gateway's web UI
  sim can                       the CAN traffic, decoded
  sim log taster-flur -f        the chip's serial log
  sim net                       create the vcan interfaces (up does it too)
  sim doctor                    check the setup

Chips and parts can be named by a unique prefix:
`sim set taster-f bme temperature=20`.
"""

import argparse
import concurrent.futures
import json
import os
import runpy
import select
import shutil
import socket
import subprocess
import sys
import time
import webbrowser
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from simlib import can, console, images, qemu, supervisor, ui  # noqa: E402
from simlib.topology import SIM_DIR, Topology, TopologyError  # noqa: E402


def load(args):
    try:
        return Topology(args.file)
    except TopologyError as e:
        ui.die(str(e))


def chip_or_die(topo, name):
    try:
        return topo.chip(name)
    except TopologyError as e:
        ui.die(str(e))


def ask(topo, req, timeout=None):
    answer = supervisor.request(topo, req, timeout)
    if answer is None:
        ui.die("the simulation isn't running", "start it with: ./sim up")
    if isinstance(answer, dict) and "error" in answer:
        ui.die(answer["error"])
    return answer


def running(topo):
    return supervisor.request(topo, {"cmd": "status"}, 2) is not None


# CAN interfaces


def missing_buses(buses):
    return [b for b in sorted(set(buses)) if not can.interface_exists(b)]


def net_commands(buses, down=False):
    if down:
        return [["ip", "link", "delete", b] for b in buses]
    out = [["modprobe", "vcan"]]
    for b in buses:
        out += [["ip", "link", "add", b, "type", "vcan"], ["ip", "link", "set", b, "up"]]
    return out


def ensure_buses(buses):
    """Creates missing vcan interfaces with sudo (asks for the password in
    a terminal)."""
    missing = missing_buses(buses)
    if not missing:
        return
    commands = net_commands(missing)
    hint = "\n  ".join("sudo " + " ".join(c) for c in commands)
    if not sys.stdin.isatty() and subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode:
        ui.die(f"no CAN interface {', '.join(missing)}", "create it (once per boot):\n  " + hint)
    print(ui.dim(f"· creating {', '.join(missing)} (sudo)"))
    for c in commands:
        if subprocess.run(["sudo", *c]).returncode:
            ui.die(f"couldn't run: sudo {' '.join(c)}", "create them by hand:\n  " + hint)


def cmd_net(args):
    topo = load(args)
    buses = topo.buses
    if args.action == "down":
        present = [b for b in buses if can.interface_exists(b)]
        for c in net_commands(present, down=True):
            subprocess.run(["sudo", *c])
        print(ui.green("✓ ") + (f"removed {', '.join(present)}" if present else "nothing to remove"))
        return
    ensure_buses(buses)
    print(ui.green("✓ ") + ", ".join(buses) + " up")


# Images and running


def cmd_build(args, topo=None, chips=None):
    topo = topo or load(args)
    chips = chips if chips is not None else [chip_or_die(topo, n) for n in args.chips] or topo.chips
    if running(topo):
        ui.die("the simulation is running", "stop it first: ./sim down")
    try:
        qemu_path = qemu.find()
    except qemu.QemuError as e:
        ui.die(str(e))
    imgs = images.Images(topo, log=lambda m: print(ui.dim("· " + m)))
    bases = {}
    try:
        for kind in sorted({images.kind_of(c) for c in chips}):
            bases[kind] = imgs.base(kind, getattr(args, f"{kind}_elf", None))
    except images.ImageError as e:
        ui.die(str(e))
    reset = getattr(args, "reset", False)
    width = max(len(c.name) for c in chips)

    def prepare(chip):
        base, firmware = bases[images.kind_of(chip)]
        return imgs.prepare(chip, base, firmware, qemu_path, reset=reset)

    failed = False
    with concurrent.futures.ThreadPoolExecutor(max(2, (os.cpu_count() or 4) // 2)) as pool:
        futures = {pool.submit(prepare, c): c for c in chips}
        for future in concurrent.futures.as_completed(futures):
            chip = futures[future]
            name = ui.chip_name(chip.name, chip.is_gateway, width)
            try:
                done = future.result()
            except Exception as e:  # noqa: BLE001
                failed = True
                print(f"{ui.red('✗')} {name}  {e}")
                continue
            if done:
                print(f"{ui.green('✓')} {name}  {done}")
            elif not getattr(args, "quiet_build", False):
                print(f"{ui.dim('·')} {name}  {ui.dim('up to date')}")
    if failed:
        ui.die("some images failed", f"the console transcripts are in {topo.state_dir / 'chips'}/*/setup.log")
    return imgs, qemu_path


def cmd_reset(args):
    if not args.chips and not args.all:
        ui.die("which chips?", "./sim reset <name>…, or every chip: ./sim reset --all")
    args.reset = True
    cmd_build(args)


def describe_node(c):
    parts = [f"{c.bus}", f"id {c.device_id}"]
    if c.buttons:
        parts.append(f"buttons {','.join(map(str, c.buttons))}")
    if c.pir_pin is not None:
        parts.append("PIR")
    names = [name for _, _, _, name, _ in c.i2c_devices()] + [s["name"] for s in c.ds18b20]
    if names:
        parts.append(" ".join(names))
    if c.relay_banks:
        boards = " ".join(("own " if b == 0 else f"{b}:") + kind for b, kind in c.relay_banks.items())
        parts.append(f"relays {boards} ({c.relay_mode})")
    return "  ".join(parts)


def cmd_up(args):
    topo = load(args)
    chips = [chip_or_die(topo, n) for n in args.chips] or topo.chips
    if running(topo):
        ui.die("the simulation is already running", "./sim status shows it, ./sim down stops it")
    ensure_buses([c.bus for c in chips])
    if args.detach:
        return detach(args, topo)
    args.quiet_build = True
    imgs, qemu_path = cmd_build(args, topo, chips)

    width = max(len(c.name) for c in topo.chips)
    print()
    print(ui.bold(f"  {len(chips)} chips") + ui.dim(f"  from {topo.path}"))
    for c in chips:
        name = ui.chip_name(c.name, c.is_gateway, width)
        detail = f"{c.bus}  {ui.cyan(c.url)}" if c.is_gateway else describe_node(c)
        print(f"  {name}  {ui.dim(c.kind.ljust(8))} {detail}")
    print(ui.dim("\n  Ctrl-C stops everything. In another terminal: ./sim tui, ./sim status, "
                 "./sim press …, ./sim set …\n"))
    sup = supervisor.Supervisor(topo, imgs, qemu_path, chips, show_all=args.all,
                                serial=args.serial, show_i2c=args.i2c)
    sup.run()


def detach(args, topo):
    """`up` in the background, its output in .sim/<topology>/up.log."""
    log = topo.state_dir / "up.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    argv = [sys.executable, str(Path(__file__).resolve()), "-f", str(topo.path), "up", *args.chips]
    for flag in ("node_elf", "gateway_elf"):
        if getattr(args, flag):
            argv += [f"--{flag.replace('_', '-')}", getattr(args, flag)]
    env = dict(os.environ, NO_COLOR="1")
    with open(log, "w") as out:
        proc = subprocess.Popen(argv, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                start_new_session=True, env=env)
    print(ui.dim(f"· starting in the background, log: {log}"))
    deadline = time.time() + args.timeout
    while time.time() < deadline:
        if running(topo):
            print(ui.green("✓ ") + f"running (pid {proc.pid}); ./sim tui, ./sim status, ./sim down")
            return
        if proc.poll() is not None:
            sys.stdout.write(log.read_text()[-3000:])
            ui.die("sim up stopped", f"see {log}")
        time.sleep(0.3)
    ui.die(f"not running after {args.timeout:g} s", f"see {log}")


def cmd_down(args):
    topo = load(args)
    if supervisor.request(topo, {"cmd": "down"}, 5) is None:
        ui.die("the simulation isn't running")
    for _ in range(150):
        if not running(topo):
            print(ui.green("✓ stopped"))
            return
        time.sleep(0.1)
    ui.die("still running after 15 s")


def relay_bar(relays):
    return "".join(ui.green("●") if r else ui.dim("○") for r in relays)


def relay_bars(s):
    """(label, bar) per relay board: "relays" for the node's own, "bank n"
    for the extension's."""
    return [("relays" if b == "0" else f"bank {b}", relay_bar(board["relays"]))
            for b, board in (s.get("banks") or {}).items()]


def cmd_status(args):
    topo = load(args)
    answer = supervisor.request(topo, {"cmd": "status"}, 5)
    if answer is None:
        print(ui.dim("not running") + "  (./sim up)")
        rows = [[ui.chip_name(c.name, c.is_gateway), c.kind, c.bus,
                 "" if c.is_gateway else c.device_id,
                 "built" if images.Images(topo).flash(c).is_file() else ui.dim("no image")]
                for c in topo.chips]
        ui.table(["NAME", "KIND", "BUS", "ID", "IMAGE"], rows)
        return
    states = {"running": ui.green, "booting": ui.yellow, "stopped": ui.red, "stopping": ui.yellow}
    rows = []
    for s in answer["chips"]:
        detail = []
        if s["kind"] == "gateway":
            detail.append(s["ip"] or ui.dim("no network yet"))
            detail.append(ui.cyan(s["url"]))
        else:
            for label, bar in relay_bars(s):
                detail.append(f"{label} {bar}")
            for name, part in (s.get("parts") or {}).items():
                detail.append(ui.dim(name + " ") + part["summary"])
            if not s["discovered"] and s["state"] == "running":
                detail.append(ui.yellow("not discovered"))
        rows.append([
            ui.chip_name(s["name"], s["kind"] == "gateway"), s["kind"], s["bus"],
            s.get("id", ""), states.get(s["state"], str)(s["state"]),
            ui.duration(s["uptime"]) if s["uptime"] else "", s["frames"] or "",
            "  ".join(detail),
        ])
    ui.table(["NAME", "KIND", "BUS", "ID", "STATE", "UP", "FRAMES", ""], rows)
    if answer["events"]:
        print()
        for e in answer["events"][-6:]:
            stamp = time.strftime("%H:%M:%S", time.localtime(e["t"]))
            print(ui.dim(f"  {stamp} {e['chip']} {e['text']}"))


# Playing


def cmd_press(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    kind = {"click": "single", "1": "single", "2": "double", "3": "triple"}.get(args.kind, args.kind)
    ask(topo, {"cmd": "press", "chip": chip.name, "button": args.button, "kind": kind, "secs": args.secs},
        timeout=args.secs + 10)
    print(ui.green("✓ ") + f"{chip.name} button {args.button} {kind}")


def cmd_motion(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    ask(topo, {"cmd": "motion", "chip": chip.name, "secs": args.secs})
    print(ui.green("✓ ") + f"{chip.name}: motion for {args.secs:g} s")


def cmd_lux(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    ask(topo, {"cmd": "lux", "chip": chip.name, "lux": args.lux})
    print(ui.green("✓ ") + f"{chip.name}: {args.lux:g} lx" + ui.dim("  (the node reports changes over 10 %)"))


def cmd_set(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    values = {}
    for v in args.values:
        key, eq, value = v.partition("=")
        if not eq:
            ui.die(f"{v!r}: key=value, for example temperature=21.5")
        values[key] = value
    answer = ask(topo, {"cmd": "set", "chip": chip.name, "device": args.part, "values": values})
    state = answer["state"]
    print(ui.green("✓ ") + f"{chip.name} {args.part}: " +
          ", ".join(f"{k} {state[k]:g}" for k in values if k in state))


def cmd_get(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    if args.part:
        state = ask(topo, {"cmd": "get", "chip": chip.name, "device": args.part})["state"]
        for k, v in state.items():
            print(f"{ui.dim(k.ljust(12))} {v}")
        return
    s = ask(topo, {"cmd": "get", "chip": chip.name})["state"]
    print(ui.bold(s["name"]) + ui.dim(f"  {s['kind']}  {s['state']}"))
    for label, bar in relay_bars(s):
        print(f"  {label.ljust(12)} {bar}")
    rows = []
    for name, part in (s.get("parts") or {}).items():
        where = f"0x{part['addr']:02x}" if part.get("addr") is not None else part.get("rom", "")
        settable = ", ".join(part.get("values", {})) or ui.dim("(output only)")
        rows.append(["  " + name, part["kind"], where, part["summary"], ui.dim(settable)])
    if rows:
        ui.table(["  PART", "KIND", "WHERE", "NOW", "SETTABLE"], rows)
    elif s["kind"] != "gateway":
        print(ui.dim("  no simulated parts (extension = \"sensors\" or \"pwm\", ds18b20 = […])"))


def cmd_pin(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    ask(topo, {"cmd": "pin", "chip": chip.name, "pin": args.pin, "level": args.level})


def cmd_restart(args):
    topo = load(args)
    for name in args.chips:
        chip = chip_or_die(topo, name)
        ask(topo, {"cmd": "restart", "chip": chip.name}, timeout=30)
        print(ui.green("✓ ") + f"{chip.name} restarted")


def number(text):
    try:
        return int(text, 0)
    except ValueError:
        ui.die(f"{text!r} isn't a number (0x77, 119, 0b1110111)")


def cmd_i2c(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    op, rest = (args.op[0], args.op[1:]) if args.op else ("trace", [])
    base = {"cmd": "i2c", "chip": chip.name, "bus": args.bus}
    if op == "trace":
        follow(topo, kinds=["i2c"], chips=[chip.name],
               title=f"{chip.name} I2C, every transaction · Ctrl-C")
    elif op == "scan":
        for d in ask(topo, {**base, "scan": True})["devices"]:
            print(f"  0x{d['addr']:02x}  {d['name']}" + ui.dim(f"  ({d['kind']})" if d["kind"] != d["name"] else ""))
    elif op == "read":
        if not rest:
            ui.die("read <addr> [<register> [<count>]]")
        addr = number(rest[0])
        write = [number(rest[1])] if len(rest) > 1 else []
        count = number(rest[2]) if len(rest) > 2 else 1
        data = ask(topo, {**base, "addr": addr, "write": write, "read": count})["read"]
        print(" ".join(f"{b:02x}" for b in data))
    elif op == "write":
        if len(rest) < 2:
            ui.die("write <addr> <byte>…  (the first byte is the register for most parts)")
        ask(topo, {**base, "addr": number(rest[0]), "write": [number(b) for b in rest[1:]]})
        print(ui.green("✓ ") + "written")
    elif op == "dump":
        if not rest:
            ui.die("dump <addr>")
        addr = number(rest[0])
        found = {d["addr"]: d for d in ask(topo, {**base, "scan": True})["devices"]}
        if addr not in found:
            ui.die(f"nothing answers at 0x{addr:02x} on bus {args.bus}")
        if not found[addr]["registers"]:
            ui.die(f"0x{addr:02x} ({found[addr]['name']}) has no register map to dump",
                   f"read it instead: ./sim i2c {chip.name} read 0x{addr:02x}")
        print(ui.dim("     " + " ".join(f"{i:2x}" for i in range(16))))
        for row in range(16):
            data = ask(topo, {**base, "addr": addr, "write": [row * 16], "read": 16})["read"]
            print(ui.dim(f"{row * 16:02x}:  ") + " ".join(f"{b:02x}" for b in data))
    else:
        ui.die(f"unknown i2c operation {op!r}", "trace (default), scan, read, write, dump")


def follow(topo, kinds=None, chips=None, title=None):
    sock = supervisor.request(topo, {"cmd": "events", "kinds": kinds, "chips": chips})
    if sock is None:
        ui.die("the simulation isn't running", "start it with: ./sim up")
    if title:
        print(ui.dim(f"── {title} ──"))
    width = max(len(c.name) for c in topo.chips)
    try:
        f = sock.makefile("rb")
        f.readline()
        for line in f:
            e = json.loads(line)
            stamp = time.strftime("%H:%M:%S", time.localtime(e["t"]))
            print(f"{ui.dim(stamp)}  {ui.chip_name(e['chip'], width=width)}  {e['text']}", flush=True)
    except KeyboardInterrupt:
        pass
    finally:
        sock.close()


def cmd_events(args):
    topo = load(args)
    follow(topo, kinds=args.kind or None, chips=[chip_or_die(topo, c).name for c in args.chips] or None,
           title="events · Ctrl-C")


def cmd_run(args):
    topo = load(args)
    if not running(topo):
        ui.die("the simulation isn't running", "start it first: ./sim up -d")
    from simlib.client import Sim
    sim = Sim(topo.path)
    sys.argv = [args.script, *args.args]
    try:
        runpy.run_path(args.script, init_globals={"sim": sim}, run_name="__main__")
    finally:
        sim.close()


def cmd_tui(args):
    topo = load(args)
    if not sys.stdout.isatty():
        ui.die("the TUI needs a terminal")
    started = False
    if not running(topo):
        print(ui.dim("· the simulation isn't running: starting it in the background"))
        subprocess.run([sys.executable, str(Path(__file__).resolve()), "-f", str(topo.path), "up", "-d"],
                       check=True)
        started = True
    from simlib import tui
    tui.run(topo.path)
    if started:
        answer = input("stop the simulation? [Y/n] ").strip().lower()
        if answer in ("", "y", "yes", "j", "ja"):
            supervisor.request(topo, {"cmd": "down"}, 5)
            print(ui.green("✓ ") + "stopping")


def cmd_console(args):
    if not sys.stdin.isatty():
        ui.die("the console needs a terminal")
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    error = console.attach(topo, chip.name)
    if error:
        ui.die(error)


def cmd_log(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip)
    path = images.Images(topo).logfile(chip)
    if not path.is_file():
        ui.die(f"no log for {chip.name} yet")
    with open(path, errors="replace") as f:
        lines = f.readlines()
        sys.stdout.writelines(lines[-args.lines:])
        if not args.follow:
            return
        try:
            while True:
                line = f.readline()
                if line:
                    sys.stdout.write(line)
                    sys.stdout.flush()
                else:
                    time.sleep(0.2)
        except KeyboardInterrupt:
            pass


def cmd_can(args):
    topo = load(args)
    buses = [args.bus] if args.bus else topo.buses
    missing = missing_buses(buses)
    if missing:
        ui.die(f"no CAN interface {', '.join(missing)}", "./sim net creates them")
    socks = {can.open_bus(b): b for b in buses}
    width = max(len(c.name) for c in topo.chips)
    print(ui.dim(f"── {', '.join(buses)} · {'everything' if args.all else 'without housekeeping (--all shows it)'} · Ctrl-C ──"))
    try:
        while True:
            r, _, _ = select.select(list(socks), [], [])
            for s in r:
                frame = can.read(s)
                if frame is None or (frame.chatter and not args.all):
                    continue
                bus = socks[s]
                node = topo.node_by_can(bus, frame.device_type, frame.device_id)
                who = ui.chip_name(node.name, width=width) if node else ui.dim(frame.device.ljust(width))
                raw = ui.dim(f"{frame.raw_id:08X}#{frame.data.hex().upper()}")
                print(f"{ui.dim(time.strftime('%H:%M:%S'))}  {ui.dim(bus)}  {who}  {frame.describe():<34} {raw}", flush=True)
    except KeyboardInterrupt:
        pass


def cmd_web(args):
    topo = load(args)
    chip = chip_or_die(topo, args.chip) if args.chip else (topo.gateways[0] if topo.gateways else None)
    if chip is None or not chip.is_gateway:
        ui.die("which gateway?")
    print(chip.url + ui.dim("  (self-signed certificate; user and password as configured on the gateway)"))
    if not args.no_open:
        webbrowser.open(chip.url)


def cmd_doctor(args):
    topo = load(args)
    ok = True

    def check(good, text, hint=None):
        nonlocal ok
        ok &= good
        print(f"{ui.green('✓') if good else ui.red('✗')} {text}")
        if not good and hint:
            print("    " + hint.replace("\n", "\n    "))

    check(True, f"topology {topo.path}: {len(topo.gateways)} gateways, {len(topo.nodes)} nodes")
    try:
        path = qemu.find()
        check(True, f"QEMU with the esp32-sim models: {path}")
    except qemu.QemuError as e:
        check(False, "QEMU", str(e))
    missing = missing_buses(topo.buses)
    check(not missing, f"CAN interfaces {', '.join(topo.buses)}", "./sim net creates them (sudo)")
    check(bool(shutil.which("espflash")), "espflash", "cargo install espflash")
    for kind in ("node", "gateway"):
        elf = images.default_elf(kind)
        check(elf.is_file(), f"{kind} firmware {elf}",
              f"cd software/{images.FIRMWARE[kind]['crate']} && cargo build --release")
    for gw in topo.gateways:
        for port in (gw.https, gw.http):
            s = socket.socket()
            try:
                s.bind(("127.0.0.1", port))
                free = True
            except OSError:
                free = running(topo)
            finally:
                s.close()
            check(free, f"port {port} for {gw.name}", "used by something else: change https/http in the topology")
    try:
        import pytest  # noqa: F401
        check(True, "pytest (for software/sim/tests)")
    except ImportError:
        print(f"{ui.dim('·')} pytest is not installed {ui.dim('(only for the tests: pip install pytest)')}")
    sys.exit(0 if ok else 1)


def main():
    p = argparse.ArgumentParser(prog="sim", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-f", "--file", default=os.environ.get("SIM_TOPOLOGY", SIM_DIR / "sim.toml"),
                   help="the topology (default: sim.toml next to this script, or $SIM_TOPOLOGY)")
    sub = p.add_subparsers(dest="command", metavar="command")

    def add(name, func, help, aliases=()):
        sp = sub.add_parser(name, help=help, description=help, aliases=list(aliases))
        sp.set_defaults(func=func)
        return sp

    sp = add("up", cmd_up, "build what's missing, start the chips and show what happens")
    sp.add_argument("chips", nargs="*", help="only these (default: all)")
    sp.add_argument("-d", "--detach", action="store_true", help="run in the background (./sim down stops it)")
    sp.add_argument("-a", "--all", action="store_true", help="also show CAN housekeeping")
    sp.add_argument("-s", "--serial", action="store_true", help="also show every serial log line")
    sp.add_argument("--i2c", action="store_true", help="also show every I2C transaction")
    sp.add_argument("--node-elf", help="node firmware (default: the release build)")
    sp.add_argument("--gateway-elf", help="gateway firmware (default: the release build)")
    sp.add_argument("--timeout", type=float, default=300, help=argparse.SUPPRESS)

    add("tui", cmd_tui, "the simulation in one screen (starts it if needed)")
    add("down", cmd_down, "stop a running simulation")
    add("status", cmd_status, "what runs, network, relays, sensor values", aliases=["st"])

    sp = add("build", cmd_build, "flash images from the release builds; keeps each chip's data")
    sp.add_argument("chips", nargs="*")
    sp.add_argument("--node-elf")
    sp.add_argument("--gateway-elf")

    sp = add("reset", cmd_reset, "factory-fresh images: configuration and data are gone")
    sp.add_argument("chips", nargs="*")
    sp.add_argument("--all", action="store_true", help="every chip")
    sp.add_argument("--node-elf")
    sp.add_argument("--gateway-elf")

    sp = add("press", cmd_press, "press a button: single (default), double, triple or hold")
    sp.add_argument("chip")
    sp.add_argument("button", type=int, help="0-3 on the board, 4-7 on a button extension")
    sp.add_argument("kind", nargs="?", default="single",
                    choices=["single", "click", "double", "triple", "hold", "1", "2", "3"])
    sp.add_argument("-t", "--secs", type=float, default=3.0, help="how long to hold (default 3)")

    sp = add("motion", cmd_motion, "the PIR sees motion")
    sp.add_argument("chip")
    sp.add_argument("secs", type=float, nargs="?", default=10.0, help="how long (default 10 s)")

    sp = add("lux", cmd_lux, "set the light the VEML7700 measures (= set <chip> veml7700 lux=…)")
    sp.add_argument("chip")
    sp.add_argument("lux", type=float)

    sp = add("set", cmd_set, "set what a part measures: set <chip> <part> key=value…")
    sp.add_argument("chip")
    sp.add_argument("part", help="bme680, bme280, scd30, veml7700, ds18b20-0, … (./sim get <chip>)")
    sp.add_argument("values", nargs="+", metavar="key=value")

    sp = add("get", cmd_get, "a chip's parts and their values")
    sp.add_argument("chip")
    sp.add_argument("part", nargs="?")

    sp = add("i2c", cmd_i2c, "raw I2C: trace (default), scan, read, write, dump")
    sp.add_argument("chip")
    sp.add_argument("op", nargs="*", metavar="op",
                    help="trace | scan | read <addr> [<reg> [<n>]] | write <addr> <byte>… | dump <addr>")
    sp.add_argument("-b", "--bus", type=int, default=1, help="0 (relay expanders) or 1 (extension, default)")

    sp = add("events", cmd_events, "follow the events (what sim up prints, and more)")
    sp.add_argument("chips", nargs="*")
    sp.add_argument("-k", "--kind", action="append",
                    choices=["info", "action", "can", "relay", "device", "serial", "i2c", "mqtt"])

    sp = add("run", cmd_run, "run a Python script against the running simulation (`sim` is there)")
    sp.add_argument("script")
    sp.add_argument("args", nargs=argparse.REMAINDER)

    sp = add("console", cmd_console, "the chip's serial console (Ctrl-] leaves)", aliases=["con"])
    sp.add_argument("chip")

    sp = add("log", cmd_log, "the chip's serial log")
    sp.add_argument("chip")
    sp.add_argument("-f", "--follow", action="store_true")
    sp.add_argument("-n", "--lines", type=int, default=40)

    sp = add("can", cmd_can, "the CAN traffic, decoded and named")
    sp.add_argument("bus", nargs="?")
    sp.add_argument("-a", "--all", action="store_true", help="also housekeeping")

    sp = add("web", cmd_web, "open a gateway's web UI")
    sp.add_argument("chip", nargs="?")
    sp.add_argument("-n", "--no-open", action="store_true", help="only print the address")

    sp = add("restart", cmd_restart, "restart chips (a power cycle)")
    sp.add_argument("chips", nargs="+")

    sp = add("pin", cmd_pin, "drive a GPIO input directly")
    sp.add_argument("chip")
    sp.add_argument("pin", type=int)
    sp.add_argument("level", type=int, choices=[0, 1])

    sp = add("net", cmd_net, "create the topology's vcan interfaces (sudo), or remove them")
    sp.add_argument("action", nargs="?", default="up", choices=["up", "down"])

    add("doctor", cmd_doctor, "check QEMU, CAN interfaces, firmware and ports")

    args = p.parse_args()
    if not args.command:
        p.print_help()
        return
    args.func(args)


if __name__ == "__main__":
    main()
